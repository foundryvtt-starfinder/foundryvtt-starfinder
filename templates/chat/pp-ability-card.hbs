<div class="sfrpg chat-card item-card">
    <header class="card-header flexrow">
        <img src="{{actorImg}}" title="{{actorName}}" width="36" height="36"/>
        <h3 class="item-name noborder">{{abilityName}}</h3>
    </header>

    {{#if description}}
    <div class="card-content">
        <p>{{{description}}}</p>
    </div>
    {{/if}}

    <footer class="card-footer">
        <span>{{ppSpent}}</span>
        <span>{{ppRemaining}}</span>
    </footer>
</div>
