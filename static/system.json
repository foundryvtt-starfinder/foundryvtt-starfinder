{
  "id": "sfrpg",
  "title": "Starfinder First Edition",
  "description": "A game system for running Starfinder First Edition in Foundry VTT.",
  "version": "14.1.1",
  "authors": [
    {
      "name": "The Starfinder System Developers"
    }
  ],
  "compatibility": {
    "minimum": 14,
    "verified": "14.365",
    "maximum": 14
  },
  "url": "https://github.com/worldsofwondergames/foundryvtt-starfinder",
  "manifest": "https://github.com/worldsofwondergames/foundryvtt-starfinder/releases/latest/download/system.json",
  "download": "https://github.com/worldsofwondergames/foundryvtt-starfinder/releases/download/14.1.1/sfrpg-14.1.1.zip",
  "flags": {
    "sfrpg": {
      "schema": 0.009
    },
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "templates",
        "sfrpg.css",
        "lang"
      ]
    }
  },
  "socket": true,
  "initiative": "1d20 + @attributes.init.value",
  "grid": {
    "distance": 5,
    "units": "ft",
    "diagonals": 4
  },
  "primaryTokenAttribute": "attributes.hp",
  "secondaryTokenAttribute": "attributes.sp",
  "media": [
    {
      "type": "cover",
      "url": "https://raw.githubusercontent.com/foundryvtt-starfinder/foundryvtt-starfinder/master/static/images/starfinder_cover.webp",
