<form class="{{cssClass}} flexcol" autocomplete="off">

    {{!-- Item Sheet Header --}}
    <header class="sheet-header flexrow">
        <img class="profile" src="{{item.img}}" title="{{item.name}}" data-edit="img" />

        <div class="header-details flexrow">
            <h1 class="charname">
                <input name="name" type="text" value="{{item.name}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.ItemName" }}" />
            </h1>

            <div class="item-subtitle">
                <h4 class="item-type">{{ localize "TYPES.Item.mechWeapon" }}</h4>
                <span class="item-status">{{itemStatus}}</span>
            </div>

            {{!-- Item Summary --}}
            <ul class="summary flexrow">
                <li class="wide" data-tooltip="{{ localize "SFRPG.ItemSheet.Header.SourceTooltip" }}">
                <input type="text" name="system.source" value="{{itemData.source}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.Source" }}"/>
                </li>
            </ul>

            {{!-- Header Attributes --}}
            <ul class="attributes flexrow">
                <li class="attribute">
                <h4 class="attribute-name box-title">{{ localize "SFRPG.ItemSheet.Header.Save" }}</h4>
                <div class="attribute-value">
                    <label>{{placeholders.savingThrow.value}}</label>
                </div>
                </li>
            </ul>

        </div>

    </header>

    {{!-- Item Sheet Navigation --}}
    <nav class="sheet-navigation tabs" data-group="primary">
        <a class="item active" data-tab="description">{{ localize "SFRPG.Description" }}</a>
        <a class="item" data-tab="details">{{ localize "SFRPG.Details" }}</a>
    </nav>

    {{!-- Item Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        {{> "systems/sfrpg/templates/items/parts/item-description.hbs"}}

        {{!-- Details Tab --}}
        <div class="tab details" data-group="primary" data-tab="details">

            <div class="bubble">
                <h3 class="bubble-header">{{ localize "SFRPG.MechSheet.Weapon.Type" }}</h3>
                <div class="bubble-info">
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.Type" }}</label>
                        <div class="form-fields">
                            <select name="system.weaponType">
                                {{selectOptions (sfrpg "mechWeaponTypes") selected=itemData.weaponType localize=true}}
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.DamageLevel" }}</label>
                        <div class="form-fields">
                            <select name="system.damageLevel">
                                {{selectOptions (sfrpg "mechWeaponDamageLevels") selected=itemData.damageLevel localize=true}}
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.LevelOverride" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.levelOverride" value="{{itemData.levelOverride}}" data-dtype="Number" placeholder="{{ localize "SFRPG.MechSheet.Weapon.LevelOverridePlaceholder" }}" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.Slot" }}</label>
                        <div class="form-fields">
                            <select name="system.slot">
                                {{selectOptions (sfrpg "mechWeaponSlots") selected=itemData.slot localize=true}}
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.SlotsUsed" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.slotsUsed" value="{{itemData.slotsUsed}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.ValidSlots" }}</label>
                        <div class="form-fields">
                            <label class="checkbox">
                                <input type="checkbox" name="system.validSlots.frame" {{checked (contains itemData.validSlots "frame")}} />
                                {{ localize "SFRPG.MechSheet.Weapon.SlotFrame" }}
                            </label>
                            <label class="checkbox">
                                <input type="checkbox" name="system.validSlots.upperLimb" {{checked (contains itemData.validSlots "upperLimb")}} />
                                {{ localize "SFRPG.MechSheet.Weapon.SlotUpperLimb" }}
                            </label>
                            <label class="checkbox">
                                <input type="checkbox" name="system.validSlots.lowerLimb" {{checked (contains itemData.validSlots "lowerLimb")}} />
                                {{ localize "SFRPG.MechSheet.Weapon.SlotLowerLimb" }}
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.Range" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.range" value="{{itemData.range}}" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.Area" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.area" value="{{itemData.area}}" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.Capacity" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.capacity" value="{{itemData.capacity}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.Usage" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.usage" value="{{itemData.usage}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.PpCost" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.ppCost" value="{{itemData.ppCost}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.MpCost" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.mpCost" value="{{itemData.mpCost}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.Critical" }}</label>
                        <div class="form-fields">
                            <select name="system.critical.effect">
                                {{selectOption "" "" selected=itemData.critical.effect}}
                                {{selectOptions (sfrpg "weaponCriticalHitEffects") selected=itemData.critical.effect localize=true}}
                            </select>
                            <input type="text" name="system.critical.dice" value="{{itemData.critical.dice}}" placeholder="e.g. 1d4" style="max-width: 5em;" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Weapon.Special" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.special" value="{{itemData.special}}" />
                        </div>
                    </div>
                </div>
            </div>

            {{!-- Saving Throw --}}
            <div class="bubble">
                <h3 class="bubble-header">{{ localize "SFRPG.Items.Action.SavingThrow" }}</h3>
                <div class="bubble-info">
                    <div class="form-group input-select">
                        <label>{{ localize "SFRPG.Items.Action.SavingThrow" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.save.dc" value="{{itemData.save.dc}}" data-dtype="String" placeholder="{{placeholders.saveDC.formula}}"/>
                            <select name="system.save.type">
                                {{selectOption "" "" selected=itemData.save.type}}
                                {{selectOptions (sfrpg "saves") selected=itemData.save.type localize=true}}
                            </select>
                            <select name="system.save.descriptor">
                                {{selectOptions (sfrpg "saveDescriptors") selected=itemData.save.descriptor localize=true}}
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            {{!-- Damage Formula --}}
            <div class="bubble">
                <h4 class="damage-header bubble-header">
                    {{ localize "SFRPG.Items.Action.DamageFormula" }}
                    <a class="damage-control add-damage bubble-icon"><i class="fas fa-plus"></i></a>
                </h4>

                <div class="bubble-info">
                    {{> "systems/sfrpg/templates/items/parts/damage-sections.hbs"}}
                </div>
            </div>

            {{!-- Special Actions --}}
            <div class="bubble">
                <h4 class="bubble-header">
                    {{ localize "SFRPG.MechSheet.Action.Actions" }}
                    <a class="mech-action-control add-action bubble-icon"><i class="fas fa-plus"></i></a>
                </h4>
                <div class="bubble-info">
                    {{> "systems/sfrpg/templates/items/parts/mech-actions.hbs"}}
                </div>
            </div>

        </div>

    </section>
</form>
