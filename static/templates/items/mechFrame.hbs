<form class="{{cssClass}} flexcol" autocomplete="off">

    {{!-- Item Sheet Header --}}
    <header class="sheet-header flexrow">
        <img class="profile" src="{{item.img}}" title="{{item.name}}" data-edit="img" />

        <div class="header-details flexrow">
            <h1 class="charname">
                <input name="name" type="text" value="{{item.name}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.ItemName" }}" />
            </h1>

            <div class="item-subtitle">
                <h4 class="item-type">{{ localize "TYPES.Item.mechFrame" }}</h4>
                <span class="item-status">{{itemStatus}}</span>
            </div>

            {{!-- Item Summary --}}
            <ul class="summary flexrow">
                <li class="wide" data-tooltip="{{ localize "SFRPG.ItemSheet.Header.SourceTooltip" }}">
                <input type="text" name="system.source" value="{{itemData.source}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.Source" }}"/>
                </li>
            </ul>

        </div>

    </header>

    {{!-- Item Sheet Navigation --}}
    <nav class="sheet-navigation tabs" data-group="primary">
        <a class="item active" data-tab="description">{{ localize "SFRPG.Description" }}</a>
        <a class="item" data-tab="details">{{ localize "SFRPG.Details" }}</a>
    </nav>

    {{!-- Item Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        {{> "systems/sfrpg/templates/items/parts/item-description.hbs"}}

        {{!-- Details Tab --}}
        <div class="tab details" data-group="primary" data-tab="details">

            <div class="bubble">
                <h3 class="bubble-header">{{ localize "SFRPG.MechSheet.Frame.Size" }}</h3>
                <div class="bubble-info">
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.Size" }}</label>
                        <div class="form-fields">
                            <select name="system.size">
                                {{selectOptions (sfrpg "mechSizes") selected=itemData.size}}
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bubble">
                <h3 class="bubble-header">{{ localize "SFRPG.Health" }}</h3>
                <div class="bubble-info">
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.BaseHp" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.baseHp" value="{{itemData.baseHp}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.HpAdvancement" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.hpAdvancement" value="{{itemData.hpAdvancement}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.Hardness" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.hardness" value="{{itemData.hardness}}" data-dtype="Number" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="bubble">
                <h3 class="bubble-header">{{ localize "SFRPG.Details" }}</h3>
                <div class="bubble-info">
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.Eac" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.eac" value="{{itemData.eac}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.Kac" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.kac" value="{{itemData.kac}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.Speed" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.speed" value="{{itemData.speed}}" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.FrameSlots" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.frameSlots" value="{{itemData.frameSlots}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.AuxSlots" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.auxSlots" value="{{itemData.auxSlots}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.OperatorsMin" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.operatorsMin" value="{{itemData.operatorsMin}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.OperatorsMax" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.operatorsMax" value="{{itemData.operatorsMax}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Frame.MpCost" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.mpCost" value="{{itemData.mpCost}}" data-dtype="Number" />
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section>
</form>
