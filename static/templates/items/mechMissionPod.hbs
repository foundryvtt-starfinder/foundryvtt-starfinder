<form class="{{cssClass}} flexcol" autocomplete="off">

    {{!-- Item Sheet Header --}}
    <header class="sheet-header flexrow">
        <img class="profile" src="{{item.img}}" title="{{item.name}}" data-edit="img" />

        <div class="header-details flexrow">
            <h1 class="charname">
                <input name="name" type="text" value="{{item.name}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.ItemName" }}" />
            </h1>

            <div class="item-subtitle">
                <h4 class="item-type">{{ localize "TYPES.Item.mechMissionPod" }}</h4>
                <span class="item-status">{{itemStatus}}</span>
            </div>

            {{!-- Item Summary --}}
            <ul class="summary flexrow">
                <li class="wide" data-tooltip="{{ localize "SFRPG.ItemSheet.Header.SourceTooltip" }}">
                <input type="text" name="system.source" value="{{itemData.source}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.Source" }}"/>
                </li>
            </ul>

        </div>

    </header>

    {{!-- Item Sheet Navigation --}}
    <nav class="sheet-navigation tabs" data-group="primary">
        <a class="item active" data-tab="description">{{ localize "SFRPG.Description" }}</a>
        <a class="item" data-tab="details">{{ localize "SFRPG.Details" }}</a>
    </nav>

    {{!-- Item Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        {{> "systems/sfrpg/templates/items/parts/item-description.hbs"}}

        {{!-- Details Tab --}}
        <div class="tab details" data-group="primary" data-tab="details">

            <div class="bubble">
                <h3 class="bubble-header">{{ localize "SFRPG.MechSheet.MissionPod.Title" }}</h3>
                <div class="bubble-info">
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.IsActive" }}</label>
                        <div class="form-fields">
                            <label class="checkbox">
                                <input type="checkbox" name="system.isActive" {{checked itemData.isActive}} />
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.MpCost" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.mpCost" value="{{itemData.mpCost}}" data-dtype="Number" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="bubble">
                <h3 class="bubble-header">{{ localize "SFRPG.MechSheet.MissionPod.Modifiers.Title" }}</h3>
                <div class="bubble-info">
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.Modifiers.HP" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.statMods.hp" value="{{itemData.modifiers.hp}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.Modifiers.SP" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.statMods.sp" value="{{itemData.modifiers.sp}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.Modifiers.EAC" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.statMods.eac" value="{{itemData.modifiers.eac}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.Modifiers.KAC" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.statMods.kac" value="{{itemData.modifiers.kac}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.Modifiers.Fort" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.statMods.fort" value="{{itemData.modifiers.fort}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.Modifiers.Ref" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.statMods.ref" value="{{itemData.modifiers.ref}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.Modifiers.Strength" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.statMods.strength" value="{{itemData.modifiers.strength}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.MissionPod.Modifiers.Speed" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.statMods.speed" value="{{itemData.modifiers.speed}}" data-dtype="Number" />
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section>
</form>
