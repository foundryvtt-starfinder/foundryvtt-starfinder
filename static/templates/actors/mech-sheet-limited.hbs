<form class="{{cssClass}} flexcol" autocomplete="off">
    <header class="sheet-header flexrow">
        <div class="image-container">
            <img class="profile" src="{{actor.img}}" title="{{actor.name}}" height="140" width="140" />
        </div>

        <div class="header-details flexcol">
            <div class="header-background flexrow" style="flex: 0 0 60px;">
                <h1 class="charname">
                    <span>{{actor.name}}</span>
                </h1>

                <div class="charlevel">
                    <div class="level noxp">
                        <label>{{ localize "SFRPG.MechSheet.Header.Tier" }}</label>
                        <span>{{labels.tier}}</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <section class="sheet-body">
        <div class="tab details active" data-group="primary" data-tab="details">
            <div class="flexrow">
                <ul class="attributes flexrow">
                    <li class="attribute health">
                        <h4 class="attribute-name box-title">{{ localize "SFRPG.Health" }}</h4>
                        <div class="attribute-value">
                            <span>{{system.attributes.hp.value}} / {{system.attributes.hp.max}}</span>
                        </div>
                    </li>
                    <li class="attribute health">
                        <h4 class="attribute-name box-title">{{ localize "SFRPG.MechSheet.Attributes.ShieldPoints" }}</h4>
                        <div class="attribute-value">
                            <span>{{system.attributes.sp.value}} / {{system.attributes.sp.max}}</span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </section>
</form>
