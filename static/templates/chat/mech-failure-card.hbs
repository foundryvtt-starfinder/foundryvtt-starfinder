<div class="sfrpg chat-card mech-failure-card" data-actor-id="{{actorId}}" data-actor-uuid="{{actorUuid}}">
    <header class="card-header flexrow">
        <img class="action-img" src="{{img}}" title="{{name}}" width="36" height="36" />
        <h3 class="action-name">{{localize "SFRPG.MechSheet.SystemFailure.Title"}}</h3>
    </header>
    <div class="card-content">
        <p>{{{prompt}}}</p>
    </div>
</div>
