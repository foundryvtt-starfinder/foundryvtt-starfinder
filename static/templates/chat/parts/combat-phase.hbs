<!-- If the roll content should be visible, show tags -->
{{#if isContentVisible}}
<div class="message-tags combat-phase">
    {{#if tags}}
    {{#each tags as |tag|}}
        {{#if tag.text}}
        <span class="tag"{{#if tag.tooltip}} data-tooltip="{{tag.tooltip}}"{{/if}}>{{{tag.text}}}</span>
        {{/if}}
    {{/each}}
    {{/if}}
</div>
{{/if}}

<div class="message-content combat-phase">
    {{{message.content}}}
</div>