<!-- If the roll content should be visible, show tags -->
{{#if isContentVisible}}
<div class="message-tags reload">
    {{#if tags}}
    {{#each tags as |tag|}}
        {{#if tag.text}}
        <span class="tag"{{#if tag.tooltip}} data-tooltip="{{tag.tooltip}}"{{/if}}>{{{tag.text}}}</span>
        {{/if}}
    {{/each}}
    {{/if}}
</div>

<div class="message-content reload">
    <div class="description">
        {{#if item.system.description.short}}
            {{{item.system.description.short}}}
        {{else}}
            {{{item.system.description.value}}}
        {{/if}}
    </div>
</div>
{{/if}}